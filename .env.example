# CloudWisePod 环境变量（复制为 .env 并填写）
# 会话密钥：openssl rand -hex 32
SESSION_SECRET=
# Groq API key（默认零成本 provider）：https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI API key（可选；仅按单次任务显式授权时使用，ADR-0009）
OPENAI_API_KEY=
# 自动知识文章：独立的 OpenAI 兼容文本 API（完整基础地址，如 https://example.com/v1）
# 三项同时配置；不会覆盖学习模型或转录模型。后台自动生成在文章页一次开启。
POD_BASE_URL=
POD_API_KEY=
POD_MODEL=
# 监听端口
PORT=8080
# 统一数据目录（DB / evidence / tmp / backups，ADR-0010）
DATA_DIR=./data
# 公网 URL（反向代理场景必须为 https；决定 Secure Cookie 与 Markdown 链接）
PUBLIC_URL=http://localhost:8080
# 受信任反向代理 CIDR，逗号分隔（仅这些来源的转发头被信任）
TRUSTED_PROXIES=

# 解说音轨（Narration，ADR-0019/D03）：自托管 Kokoro TTS；引擎不可用时自动跳过合成，原音与学习功能不受影响。
# 发行版与安装步骤见 docs/production-deployment.md「解说音轨」：kokoro-onnx 运行时 + scripts/kokoro 包装。
KOKORO_BINARY=scripts/kokoro
# 默认音色：中文 zf_xiaobei / zm_yunyang 等（Kokoro v1.0 官方中文音色）；英文 af_heart
KOKORO_VOICE=zf_xiaobei
# 权重位置：KOKORO_MODEL=完整 onnx 路径；KOKORO_MODEL_DIR=目录（取其中 kokoro-v1.0.onnx + voices-v1.0.bin）
KOKORO_MODEL=
KOKORO_MODEL_DIR=
# 语言（en|zh；仅用于预检一致性提示，实际语言按音色前缀自动推断）
KOKORO_LANGUAGE=zh
# 单次合成超时秒数
KOKORO_TIMEOUT_SECONDS=120

# 可选：独立审校模型；默认使用 POD_MODEL，共用 POD 连接与凭据。
POD_REVIEW_MODEL=
# 可选：发现、选材、写作/修订、学习回顾模型，均默认回退到 POD_MODEL。
# 共用 POD 文本连接；新任务冻结有效配置，修改后不影响在途任务。
POD_DISCOVERY_MODEL=
POD_SELECTION_MODEL=
POD_WRITE_MODEL=
POD_LEARNING_REVIEW_MODEL=

# 可选：个人语音笔记ASR。留空沿用设置页的转录provider/model。
# 不复用POD文本端点；变更在重启后生效，新任务冻结模型和连接身份。
VOICE_ASR_PROVIDER=
VOICE_ASR_MODEL=
# 自定义音频连接必须四项完整；只写在服务端，不进入草稿或任务载荷。
VOICE_ASR_BASE_URL=
VOICE_ASR_API_KEY=
