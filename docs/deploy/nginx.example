# Nginx 反向代理示例（公网 HTTPS，ADR-0013）
# 自行签发 TLS 证书（certbot / 云平台证书）。
server {
    listen 443 ssl;
    server_name cwp.example.com;

    ssl_certificate     /etc/letsencrypt/live/cwp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cwp.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 大音频上传需要
        client_max_body_size 500m;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
